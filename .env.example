# Choose'Tounsi API (Laravel 8). Copy to .env and fill in.
# Values here are local-development placeholders; production notes are in the comments.
# Never commit a real .env.

# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://api.choosetounsi.tn
APP_NAME="Choose'Tounsi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
#ASSET_URL=

# Storefront and admin panel URLs (links in e-mails, WhatsApp messages, "view on storefront").
# Production: https://choosetounsi.tn and https://admin.choosetounsi.tn
FRONTEND_URL=http://localhost:3000

# API rate limit per user (or IP when logged out): reads = GET, writes = everything else
# (login, register, checkout, forms). One storefront page view is ~10 reads.
API_READS_PER_MINUTE=300
API_WRITES_PER_MINUTE=60
ADMIN_URL=http://localhost:3001

# Browser origins allowed to call the API (comma-separated). Empty → localhost:3000/3001/3002.
# Production: https://choosetounsi.tn,https://www.choosetounsi.tn,https://admin.choosetounsi.tn
CORS_ALLOWED_ORIGINS=

# First admin account (database/seeders/AdminSeeder.php, admin@choosetounsi.com).
# Required when APP_ENV=production. Use a long random value and change it after the first login.
ADMIN_INITIAL_PASSWORD=

# Production: LOG_CHANNEL=daily, LOG_LEVEL=warning
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
#LOG_SLACK_WEBHOOK_URL=
#LOG_STDERR_FORMATTER=
#PAPERTRAIL_URL=
#PAPERTRAIL_PORT=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=choosetounsi
DB_USERNAME=root
DB_PASSWORD=
#DB_SOCKET=
#DATABASE_URL=
#MYSQL_ATTR_SSL_CA=
#DB_FOREIGN_KEYS=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
#CACHE_PREFIX=
FILESYSTEM_DRIVER=public
QUEUE_CONNECTION=database
#QUEUE_FAILED_DRIVER=database-uuids
#BCRYPT_ROUNDS=10

# The API authenticates with Bearer tokens; sessions are only used at the margin.
# Production: SESSION_DOMAIN=.choosetounsi.tn, SESSION_SECURE_COOKIE=true
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_PATH=/
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
#SESSION_CONNECTION=
#SESSION_STORE=

# Empty → localhost, localhost:3000/3001, 127.0.0.1(:8000), ::1 and the APP_URL host.
# Production: choosetounsi.tn,www.choosetounsi.tn,admin.choosetounsi.tn
SANCTUM_STATEFUL_DOMAINS=

# Production: Brevo SMTP relay (smtp-relay.brevo.com:587, tls); login = Brevo SMTP login, password = Brevo SMTP key
# (not the API key). From = an address on our authenticated domain (SPF/DKIM/DMARC), never @gmail.com.
# Local: MAIL_MAILER=log writes e-mails to storage/logs/laravel.log instead of sending.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contact@choosetounsi.tn
MAIL_FROM_NAME="Choose'Tounsi"
# Replies to every e-mail go here (config/mail.php reply_to). Empty = no Reply-To.
MAIL_REPLY_TO_ADDRESS=
#MAIL_REPLY_TO_NAME="Choose'Tounsi"
#MAIL_VERIFY_PEER=true
#MAIL_LOG_CHANNEL=
#MAIL_SENDMAIL_PATH=
# Optional PNG logo (~320x80, absolute https URL) at the top of transactional e-mails
MAIL_LOGO_URL=

# Google sign-in (Socialite). Production redirect: https://api.choosetounsi.tn/api/auth/google/callback
# (must also be listed as an authorised redirect URI in the Google Cloud console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost:8000/api/auth/google/callback

# Card payments (Stripe). Not used at launch (cash on delivery only): leave empty.
# Webhook endpoint: https://api.choosetounsi.tn/api/payment/stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# D17 transfer account shown at checkout
D17_ACCOUNT_NUMBER=

# Seller order e-mails are queued on "notifications":
#   php artisan queue:work --queue=notifications,default
SELLER_NOTIFICATIONS_QUEUE=notifications
#SELLER_NOTIFICATIONS_TIMEZONE=Africa/Tunis
# Remind sellers about confirmed sub-orders not ready for pickup after N hours
SELLER_PICKUP_REMINDER=false
SELLER_PICKUP_REMINDER_HOURS=24

# Buyer notifications (config/notifications.php)
#NOTIFICATIONS_QUEUE=default
#NOTIFICATIONS_TIMEZONE=Africa/Tunis
#NOTIFICATIONS_REVIEW_DELAY_DAYS=3

# Seller WhatsApp notices (config/seller_whatsapp.php). Links in the messages use
# FRONTEND_URL: set it to the live site (https://...), never localhost, in production.
WHATSAPP_BUSINESS_NUMBER=21657252576
SELLER_WHATSAPP_WORK_START=08:00
SELLER_WHATSAPP_WORK_END=20:00
SELLER_WHATSAPP_MORNING_TIME=08:30
#SELLER_WHATSAPP_TIMEZONE=Africa/Tunis
#SELLER_WHATSAPP_REMINDER_1_HOURS=2
#SELLER_WHATSAPP_REMINDER_2_HOURS=4
#SELLER_WHATSAPP_OVERDUE_HOURS=4

# AI shopping chatbot (Groq free tier — key stays server-side only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=15
GROQ_DAILY_BUDGET=950
GROQ_MINUTE_BUDGET=25
CHAT_DEFAULT_LANGUAGE=fr
AI_CHAT_SEARCH_TIMEOUT=3
AI_CHAT_MIN_SCORE=0.35

# AI product descriptions (seller dashboard) — same Groq key, shared free-tier budget
AI_DESC_MODEL=openai/gpt-oss-120b
AI_DESC_FALLBACK_MODEL=openai/gpt-oss-20b
AI_DESC_RESERVE_CALLS=150
AI_DESC_LIMIT_FREE=5
AI_DESC_LIMIT_RED=40
AI_DESC_LIMIT_BLACK=150
#AI_DESC_REASONING=low
#AI_DESC_TIMEOUT=45

# Price watch (seller tool, google.serper.dev). Empty → the tool is disabled.
SERPER_API_KEY=

# Search by photo: choosetounsi-ai-service (CLIP). Loopback only; point it at another server
# later without code changes. Shared secret = the service's AI_SERVICE_TOKEN.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
# Optional tuning (defaults in config/search.php → image)
#IMAGE_SEARCH_TIMEOUT=3
#IMAGE_SEARCH_PER_MINUTE=10
#IMAGE_SEARCH_MIN_SCORE=0.78
#IMAGE_SEARCH_EXACT=0.87
#IMAGE_SEARCH_CACHE_MINUTES=10
#IMAGE_SEARCH_LOG_DAYS=180
#IMAGE_SEARCH_CATEGORY_BOOST=0.05
#IMAGE_SEARCH_COLOR_BOOST=0.03
#IMAGE_SEARCH_COLOR_DISTANCE=45
#IMAGE_SEARCH_VOTE_BOOST=0.02
#IMAGE_SEARCH_CENTROID_MIN=0.75
#IMAGE_SEARCH_OUTSIDE_MIN=0.82
#IMAGE_SEARCH_MARGIN_MIN=0.02
#IMAGE_SEARCH_MAX_GAP=0.15
#IMAGE_SEARCH_SECOND_GAP=0.015
# Text search (config/search.php)
#SEARCH_INDEXING=true
#SEARCH_LOW_RESULTS=3

# Intigo delivery API (config/intigo.php). fake = no network, no real parcel (nid FAKE-…).
# Switch to live only once the key, webhook, pickup addresses and per-size prices are set.
# Webhook endpoint: https://api.choosetounsi.tn/api/webhooks/intigo
INTIGO_MODE=fake
INTIGO_API_KEY=
INTIGO_BASE_URL=https://api.intigo.net/api/v3
# Webhook HMAC secret (config/services.php: services.intigo.webhook_secret), given by Intigo. Empty = webhooks refused (401).
INTIGO_WEBHOOK_SECRET=
INTIGO_CAN_OPEN_DEFAULT=false
# Pickup address index for CHOOSE'Tounsi's own products (sellers: set in the admin panel)
INTIGO_PLATFORM_PICKUP_INDEX=
#INTIGO_TIMEOUT=20
#INTIGO_CONNECT_TIMEOUT=8
#INTIGO_PICKUP_CONTACT_IN_ADDRESS=true

# Platform pickup address and support phone (config/delivery.php)
PLATFORM_PICKUP_NAME="CHOOSE'Tounsi"
PLATFORM_PICKUP_CONTACT=
PLATFORM_PICKUP_PHONE=
PLATFORM_PICKUP_ADDRESS=
PLATFORM_PICKUP_CITY=
PLATFORM_PICKUP_WILAYA=
PLATFORM_PICKUP_POSTAL_CODE=
PLATFORM_PICKUP_NOTES=
PLATFORM_SUPPORT_PHONE=
# Initial delivery fees, read once by the 2026_10_19 delivery settings migration (then edited in the admin)
#SHIPPING_AGENCY_COST=8.0
#RETURN_SHIPPING_FEE=8.0

# Address geocoding for the pickup map (Nominatim usage policy: identify the app)
#NOMINATIM_URL=https://nominatim.openstreetmap.org/search
#NOMINATIM_USER_AGENT="ChooseTounsi/1.0 (pickup address map; contact@choosetounsi.tn)"

# Sponsored products (config/ads.php)
#ADS_TIMEZONE=Africa/Tunis
#ADS_MANUAL_TOP_UP=true
# Default: true only when APP_ENV=local. Keep false in production.
#ADS_SANDBOX_TOP_UP=false

# Seller insights (timezones and queues)
#FORECAST_TIMEZONE=Africa/Tunis
#FORECAST_QUEUE=default
#FUNNEL_TIMEZONE=Africa/Tunis
#GROWTH_TIMEZONE=Africa/Tunis
#GROWTH_QUEUE=default
#GROWTH_AI_HEADLINES=true
#PROFIT_TIMEZONE=Africa/Tunis

# Stock and listing alerts (config/stock.php, config/alerts.php)
#STOCK_LOW_THRESHOLD=2
#STOCK_ALERT_GROUP_WINDOW=10
#ALERT_WINDOW_DAYS=30
#ALERT_MIN_LISTING_AGE_DAYS=30
#ALERT_LOW_VIEWS_THRESHOLD=50
#ALERT_LOW_SALES_THRESHOLD=3
#ALERT_HIGH_STOCK_THRESHOLD=15
#ALERT_STOCK_SALES_RATIO=10.0
#ALERT_DEBUG_MODE=false

# Laravel defaults for drivers the platform does not use (no Redis, S3, Pusher, Mailgun…).
MEMCACHED_HOST=127.0.0.1
#MEMCACHED_PORT=11211
#MEMCACHED_USERNAME=
#MEMCACHED_PASSWORD=
#MEMCACHED_PERSISTENT_ID=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
#REDIS_URL=
#REDIS_CLIENT=phpredis
#REDIS_CLUSTER=redis
#REDIS_PREFIX=
#REDIS_DB=0
#REDIS_CACHE_DB=1
#REDIS_QUEUE=default

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
#AWS_URL=
#AWS_ENDPOINT=
#SQS_PREFIX=
#SQS_QUEUE=default
#SQS_SUFFIX=
#DYNAMODB_CACHE_TABLE=cache
#DYNAMODB_ENDPOINT=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
#ABLY_KEY=

#MAILGUN_DOMAIN=
#MAILGUN_SECRET=
#MAILGUN_ENDPOINT=api.mailgun.net
#POSTMARK_TOKEN=
