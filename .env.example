APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dev: MAIL_MAILER=log (e-mails go to storage/logs/laravel.log) or Mailtrap's
# sandbox SMTP. Production: Brevo SMTP (smtp-relay.brevo.com:587, tls) with an
# address on your own authenticated domain (SPF/DKIM/DMARC), not @gmail.com.
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@choosetounsi.tn
MAIL_FROM_NAME="Choose'Tounsi"
# Optional PNG logo (~320x80, absolute https URL) at the top of transactional e-mails
MAIL_LOGO_URL=

# Seller order e-mails are queued on "notifications":
#   php artisan queue:work --queue=notifications,default
SELLER_NOTIFICATIONS_QUEUE=notifications
# Remind sellers about confirmed sub-orders not ready for pickup after N hours
SELLER_PICKUP_REMINDER=false
SELLER_PICKUP_REMINDER_HOURS=24

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# AI shopping chatbot (Groq free tier — key stays server-side only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=15
GROQ_DAILY_BUDGET=950
GROQ_MINUTE_BUDGET=25
CHAT_DEFAULT_LANGUAGE=fr
# FastAPI semantic search (optional — chatbot falls back to SQL when down)
AI_SERVICE_URL=http://127.0.0.1:8001
# Embedding service (choosetounsi-ai-service); shared secret = its AI_SERVICE_TOKEN
AI_SERVICE_TOKEN=
AI_CHAT_SEARCH_TIMEOUT=3
AI_CHAT_MIN_SCORE=0.35

# D17 transfer account shown at checkout
D17_ACCOUNT_NUMBER=

# Search: Meilisearch bound to 127.0.0.1, started with the same master key
# (MEILI_MASTER_KEY). Never expose it to the frontend: only Laravel talks to Meilisearch.
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
# Multilingual vectors in the search bar (needs TEXT_ENABLED=true in the AI service)
SEARCH_SEMANTIC=true

# AI product descriptions (seller dashboard) — same Groq key, shared free-tier budget
AI_DESC_MODEL=openai/gpt-oss-120b
AI_DESC_FALLBACK_MODEL=openai/gpt-oss-20b
AI_DESC_RESERVE_CALLS=150
AI_DESC_LIMIT_FREE=5
AI_DESC_LIMIT_RED=40
AI_DESC_LIMIT_BLACK=150
